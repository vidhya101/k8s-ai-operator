# cp into terraform/platform/gcp/gcp.auto.tfvars (or pass -var-file=) and fill in the real values.

name               = "my-platform"
environment        = "dev"
kubernetes_version = "1.30"

gcp_project_id = "CHANGE_ME"
gcp_region     = "us-central1"

node_min_count = 2
node_max_count = 5

tags = {
  team = "platform"
}
