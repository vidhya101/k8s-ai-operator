# cp into terraform/platform/azure/azure.auto.tfvars (or pass -var-file=) and fill in the real values.

name               = "my-platform"
environment        = "dev"
kubernetes_version = "1.30"

azure_subscription_id = "CHANGE_ME"
azure_location        = "eastus"

node_min_count = 2
node_max_count = 5

tags = {
  team = "platform"
}
