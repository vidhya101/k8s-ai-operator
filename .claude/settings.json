    "deny": [
      "Read(**/terra-key-ec2)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/devops-tokens.env)",
      "Read(**/tokens.env)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/kubeconfig)",
      "Read(**/.kube/config)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
