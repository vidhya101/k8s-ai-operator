# devops-tokens.env — TEMPLATE
#
# TEMPLATE ONLY. Do NOT put real values in this file (it's in the repo).
# Real values live in ~/.config/devops-tokens.env — see .claude/config/environment.md
# and .claude/scripts/setup-tokens.sh for how to bootstrap the real file.
#
# Format: standard shell env-var exports. This file gets `source`d by your shell
# profile so every process you launch (claude, docker, kubectl, etc.) sees the
# env vars. Agents read the ENV VAR VALUES — they never read this file directly.
#
# ─────────────────────────────────────────────────────────────────────────────
# AI provider tokens
# ─────────────────────────────────────────────────────────────────────────────

export ANTHROPIC_API_KEY=""              # https://console.anthropic.com/settings/keys
export OPENAI_API_KEY=""                 # https://platform.openai.com/api-keys
export GEMINI_API_KEY=""                 # https://aistudio.google.com/apikey
export GROQ_API_KEY=""                   # https://console.groq.com/keys
export DEEPSEEK_API_KEY=""               # https://platform.deepseek.com/api_keys
export MISTRAL_API_KEY=""                # https://console.mistral.ai/api-keys
export COHERE_API_KEY=""                 # https://dashboard.cohere.com/api-keys
export HUGGINGFACE_API_TOKEN=""          # https://huggingface.co/settings/tokens
export TOGETHER_API_KEY=""               # https://api.together.xyz/settings/api-keys
export PERPLEXITY_API_KEY=""             # https://www.perplexity.ai/settings/api
export REPLICATE_API_TOKEN=""            # https://replicate.com/account/api-tokens
export OPENROUTER_API_KEY=""             # https://openrouter.ai/keys

# Ollama (local LLM — URL, not a secret; override only if not on localhost)
export OLLAMA_HOST="http://localhost:11434"

# ─────────────────────────────────────────────────────────────────────────────
# Git / GitHub / GitLab / container registries
# ─────────────────────────────────────────────────────────────────────────────

export GH_TOKEN=""                       # PAT for `gh` CLI when not using `gh auth login` (classic scopes: repo, workflow, write:packages)
export GITHUB_TOKEN=""                   # alias many tools expect; usually same value as GH_TOKEN
export GITLAB_TOKEN=""                   # GitLab PAT if you use it

# Docker Hub / GHCR / any generic docker registry (prefer `docker login` for keychain storage)
export DOCKER_USERNAME=""
export DOCKER_PASSWORD=""                # a Docker Hub personal access token, NOT your account password

# ─────────────────────────────────────────────────────────────────────────────
# Cloud provider — prefer CLI auth over env-var secrets where possible
# ─────────────────────────────────────────────────────────────────────────────

# AWS — prefer `aws sso login` or profile+MFA over these; only set for CI-like use
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""
# export AWS_SESSION_TOKEN=""            # if using temporary creds
export AWS_PROFILE=""                    # which profile in ~/.aws/credentials to use — NOT a secret
export AWS_REGION=""                     # default region — NOT a secret

# Azure — prefer `az login` over env-var creds
# export AZURE_TENANT_ID=""
# export AZURE_CLIENT_ID=""
# export AZURE_CLIENT_SECRET=""

# GCP — prefer `gcloud auth application-default login` over service-account JSON keys
# export GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# OCI — CLI uses ~/.oci/config; usually nothing to set here
# export OCI_CLI_PROFILE="DEFAULT"

# ─────────────────────────────────────────────────────────────────────────────
# Databases (connection strings — passwords ARE secrets)
# ─────────────────────────────────────────────────────────────────────────────

# Postgres: prefer ~/.pgpass (chmod 600) over env vars; leave PGPASSWORD unset in production shells
# export PGPASSWORD=""

# Fleet-specific (if you use the ledger/audit-sink pattern from claude-imp/)
# export FLEET_LEDGER_URL="postgres://fleet:PASSWORD@192.168.56.50:5432/fleet"
# export FLEET_AUDIT_URL="postgres://audit_writer:PASSWORD@192.168.56.60:5432/fleet_audit"

# ─────────────────────────────────────────────────────────────────────────────
# Secret managers (URLs; TOKENS should be short-lived, obtained via `vault login`)
# ─────────────────────────────────────────────────────────────────────────────

export VAULT_ADDR=""                     # e.g. https://vault.internal:8200
# export VAULT_TOKEN=""                  # obtain via `vault login <auth-method>`, don't hardcode

# ─────────────────────────────────────────────────────────────────────────────
# Observability / on-call
# ─────────────────────────────────────────────────────────────────────────────

export DATADOG_API_KEY=""
export DATADOG_APP_KEY=""
export DD_SITE="datadoghq.com"           # or datadoghq.eu, us3, etc.
export DYNATRACE_API_TOKEN=""
export DYNATRACE_ENV_URL=""              # e.g. https://xxx.live.dynatrace.com
export PAGERDUTY_TOKEN=""
export OPSGENIE_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Chat / messaging (for chatops)
# ─────────────────────────────────────────────────────────────────────────────

export SLACK_BOT_TOKEN=""                # xoxb-...
export SLACK_APP_TOKEN=""                # xapp-...
export SLACK_WEBHOOK_URL=""              # incoming webhook URL — treat as secret

# ─────────────────────────────────────────────────────────────────────────────
# Package registries
# ─────────────────────────────────────────────────────────────────────────────

export NPM_TOKEN=""                      # for private npm packages
export PYPI_TOKEN=""                     # for `twine upload` to PyPI
export JFROG_TOKEN=""                    # if you use JFrog Artifactory

# ─────────────────────────────────────────────────────────────────────────────
# End of template. Add project-specific env vars below as needed.
