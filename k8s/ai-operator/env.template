# Copy to .env  (cp env.template .env).  ALL of these are optional — the defaults work.
# Format: KEY=value, one per line. No spaces around '='. '#' starts a comment.

# Which cluster to install into. Leave blank and install.sh lists your kube contexts and asks.
# (or pass  ./install.sh --context <name>)
KUBE_CONTEXT=

# How autonomous the operator is:  observe (report only) | assist (auto low-risk, PR the rest) | auto
MODE=observe

# --- Ollama (LLM backend) --------------------------------------------------------------------
# By default Ollama runs INSIDE the cluster (nothing to configure). Its models are small (<=8B)
# so CPU inference is usable. Set this ONLY if you want to use a faster external/GPU Ollama:
#   OLLAMA_EXTERNAL_URL=http://192.168.1.50:11434
# It must bind 0.0.0.0 and be reachable from cluster pods; install.sh verifies before continuing.
OLLAMA_EXTERNAL_URL=

# --- Git (optional — lets the operator scan a repo's YAML and open PRs) ----------------------
# GIT_REPO_URL=https://github.com/OWNER/your-manifests-repo.git
# GIT_TOKEN=<PAT with contents:write + pull_requests:write>
GIT_REPO_URL=
GIT_TOKEN=

# --- Advanced: run a fork / branch of the operator code -------------------------------------
# SRC_REPO=https://github.com/vidhya101/k8s-ai-operator.git
# SRC_REF=main
