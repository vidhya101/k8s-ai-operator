# Copy to .env  (cp env.template .env)  and fill in. .env must stay git-ignored — never commit it.
# install.sh reads .env and turns it into a Kubernetes Secret + manifest substitutions.

# --- Ollama -------------------------------------------------------------------------------------
# IP of the box running `ollama serve`, AS SEEN FROM THE CLUSTER NODES (not "localhost").
# Ollama must be started bound to all interfaces:  OLLAMA_HOST=0.0.0.0:11434 ollama serve
#   kubeadm / k3s VMs on a host-only net (192.168.56.0/24): the host's IP on that net, e.g.
#       192.168.56.1   (check: `ifconfig | grep 192.168.56` on the host; ping it from a node)
#   Linux + kind:      172.17.0.1  (docker0)  or the machine's LAN IP
#   Docker Desktop:    host.docker.internal   or  192.168.65.254
#   separate VM:       that VM's LAN IP
# Verify BEFORE install:  from a cluster node run  curl http://<OLLAMA_IP>:11434/api/tags
OLLAMA_IP=192.168.56.1
OLLAMA_PORT=11434
OLLAMA_IN_CLUSTER=false          # true => run Ollama as a Deployment instead (needs a big node)

# --- Git (optional but needed for repo scanning + PRs) -----------------------------------------
GIT_REPO_URL=https://github.com/OWNER/REPO.git
GIT_TOKEN=                        # PAT with contents:write + pull_requests:write
GIT_BRANCH_BASE=main

# --- image -----------------------------------------------------------------------------------
# kind / minikube / docker-desktop: leave IMAGE_REPO blank (install.sh side-loads the image).
# ANY OTHER cluster (kubeadm, k3s, cloud): set a registry the nodes can pull from + a token.
#
#   Docker Hub:   docker login   (username + Docker Hub access token), then:
#     IMAGE_REPO=docker.io/<dockerhub-username>/ai-operator
#     REGISTRY_TOKEN=<the Docker Hub access token>     # omit if you make the repo Public
#
#   GHCR:  needs a GitHub PAT with 'write:packages' (the `gh` CLI token does NOT have it):
#     echo <PAT> | docker login ghcr.io -u <github-user> --password-stdin
#     IMAGE_REPO=ghcr.io/<github-user>/ai-operator
#     REGISTRY_TOKEN=<PAT>
IMAGE_REPO=
IMAGE_TAG=v0.1.0
REGISTRY_TOKEN=                   # pull-secret password; blank => install.sh assumes the repo is public
REGISTRY_USER=                    # optional override; auto-derived from IMAGE_REPO / `gh` otherwise
# Only if your nodes are a DIFFERENT arch than your build machine (Apple Silicon -> amd64 VMs).
# install.sh otherwise auto-targets the nodes' architecture.
IMAGE_PLATFORM=                   # e.g. linux/amd64

# --- behaviour at first boot ---------------------------------------------------------------
MODE=observe                      # observe | assist | auto   (start with observe)
